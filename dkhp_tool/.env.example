# ==== HCMUS DKHP tool config ====
# Copy this file to .env and fill in your values. NEVER commit .env.

# Tài khoản portal (chỉ cần cho login tự động qua 2captcha)
USERNAME_SV=24xxxxxx
PASSWORD_SV=your_password_here

# API key 2captcha.com (đăng ký + nạp ~$3 => ~1000 lần giải reCAPTCHA)
# Không có key thì dùng lệnh: python run.py cookie
TWOCAPTCHA_API_KEY=

# Mirror dùng chính (1..20). 0 = tự chọn mirror nhanh nhất
MIRROR=0

# Giây giữa 2 lần thăm dò trong race mode
POLL_INTERVAL=1.0

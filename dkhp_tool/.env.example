# ==== HCMUS DKHP tool config ====
# Copy this file to .env and fill in your values. NEVER commit .env.

# Tài khoản portal (chỉ cần cho login tự động qua 2captcha)
USERNAME_SV=24xxxxxx
PASSWORD_SV=your_password_here

# API key anticaptcha.top — dịch vụ Việt Nam, ~30đ/lần giải reCAPTCHA,
# thanh toán nội địa (chuyển khoản). Tool ưu tiên dùng key này nếu có.
# Kiểm tra số dư: lệnh `login` sẽ tự báo.
ANTICAPTCHA_API_KEY=

# API key 2captcha.com (dự phòng, ~$3/1000 lần, thanh toán quốc tế)
TWOCAPTCHA_API_KEY=

# Mirror dùng chính (1..20). 0 = tự chọn mirror nhanh nhất
MIRROR=0

# Giây giữa 2 lần thăm dò trong race mode
POLL_INTERVAL=1.0

# ---- Cookie dán tay (tùy chọn, thay cho login-manual) ----
# Lấy từ browser: F12 > Application > Cookies > new-portalN.hcmus.edu.vn
# Nhớ: 1 cookie chỉ dùng cho đúng mirror đã đăng nhập!
# PORTAL4_ASPXAUTH=C7C0CCC1...
# PORTAL4_SESSIONID=ykeq...
# PORTAL11_ASPXAUTH=...
# PORTAL11_SESSIONID=...
